ADMIN_PASSWORD=          # пароль веб-панели
WEB_PORT=8080

TELEGRAM_BOT_TOKEN=      # от @BotFather
TELEGRAM_MODE=polling    # polling | webhook | off
TELEGRAM_WEBHOOK_SECRET= # для webhook

# ИИ: бесплатно — Workers AI по REST (токен с правом Workers AI: Read)
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.cloudflare.com/client/v4/accounts/ACCOUNT_ID/ai/v1
LLM_API_KEY=
LLM_MODEL=@cf/google/gemma-4-26b-a4b-it
LLM_EXTRA_BODY='{"chat_template_kwargs":{"enable_thinking":false}}'
# OpenRouter: LLM_PROVIDER=openrouter LLM_API_KEY=sk-or-... LLM_MODEL=deepseek/deepseek-v4-flash LLM_BASE_URL= LLM_EXTRA_BODY=
# DeepSeek:   LLM_BASE_URL=https://api.deepseek.com LLM_MODEL=deepseek-v4-flash LLM_EXTRA_BODY='{"thinking":{"type":"disabled"}}'
# Claude:     LLM_PROVIDER=anthropic LLM_API_KEY=sk-ant-... LLM_MODEL=claude-opus-5-5 LLM_BASE_URL= LLM_EXTRA_BODY=
# Ollama:     LLM_BASE_URL=http://host.docker.internal:11434/v1 LLM_MODEL=<модель>

BOT_MESSAGES_PER_USER_PER_DAY=100
LLM_CALLS_PER_DAY=1000   # на весь бот
BOT_MAX_MESSAGE_LENGTH=500
ADMIN_LOGIN_ATTEMPTS_PER_HOUR=10
APP_TIMEZONE=Europe/Moscow

# Только для make cf-*
CF_D1_DATABASE_ID=
WORKER_URL=
